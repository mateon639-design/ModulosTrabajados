<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="auth_signup.login" inherit_id="web.login" name="Sign up - Reset Password">
		<xpath expr="//button[@type='submit']" position="after">
			<div class="justify-content-between mt-2 d-flex small">
				<a t-attf-href="/web/signup?{{ keep_query() }}">
					Don't have an account?
				</a>
				<a t-attf-href="/web/reset_password?{{ keep_query() }}">
					Reset Password
				</a>
			</div>
		</xpath>
	</template>
	<template id="auth_signup.fields" name="Auth Signup/ResetPassword form fields">
		<div class="mb-3 field-name">
			<label for="name">
				Nombre / Razón Social
			</label>
			<input type="text" name="name" t-att-value="name" id="name" autofocus="autofocus" class="form-control form-control-sm" placeholder="Ej. John Doe" required="required" t-att-readonly="'readonly' if only_passwords else None" t-att-autofocus="'autofocus' if login and not only_passwords else None" />
		</div>
		<div class="mb-3 field-l10n_latam_identification_type_id">
			<label for="l10n_latam_identification_type_id">
				Tipo Identificación
			</label>
			<select id="l10n_latam_identification_type_id" class="form-control form-control-sm" name="l10n_latam_identification_type_id" required="required">
				<option value="4">
					NIT
				</option>
				<option value="5">
					Cédula de ciudadanía
				</option>
				<option value="9">
					Cédula de extranjería
				</option>
			</select>
		</div>
		<div class="mb-3 field-login">
			<label for="login">
				Identificación
			</label>
			<input type="text" name="login" t-att-value="login" id="login" class="form-control form-control-sm" autocapitalize="off" required="required" t-att-readonly="'readonly' if only_passwords else None" placeholder="Identificación" />
		</div>
		<div class="mb-3 field-password pt-2" style="display: none;">
			<label for="password">
				Password
			</label>
			<input type="password" name="password" id="password" placeholder="*******" class="form-control form-control-sm"/>
		</div>
		<div class="mb-3 field-confirm_password" style="display: none;">
			<label for="confirm_password">
				Confirm Password
			</label>
			<input type="password" name="confirm_password" placeholder="*******" id="confirm_password" class="form-control form-control-sm" />
		</div>
		<hr />
		<div class="mb-3 field-politica_datos">

			<input type="checkbox" style="display: inline;" name="politica_datos" id="politica_datos" class="form-control form-control-sm form-check-input" required="required" />
			
			<span for="politica_datos" style="font-size:11px;display: inline;">
				Autorizo el tratamiento de mis datos personales a lorem ipsum LTDA. de acuerdo con su politica de tratamiento de información la cual puede ser consultada en la sección <strong><a href="#">Política de Tratamiento de Datos</a></strong>.
			</span>
		</div>


		
	</template>
</odoo>
