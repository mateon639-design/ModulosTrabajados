<odoo>
    <data>
        <!-- res.partner.supplier.req action window -->
        <record id="res_partner_supplier_req_action" model="ir.actions.act_window">
            <field name="name">Requisitos Vinculación</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner.supplier.req</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Crear Nuevo Requisito
                </p>
                <p>
                    No se han creado requisitos de proveedor!
                </p>
            </field>
        </record>

        <!-- res.partner.supplier.req list view -->
        <record id="res_partner_supplier_req_view_list" model="ir.ui.view">
            <field name="name">res.partner.supplier.req.view.list</field>
            <field name="model">res.partner.supplier.req</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="req_optional"/>
                    <field name="name"/>
                    <field name="type_req"/>
                </list>
            </field>
        </record>
    </data>
</odoo>