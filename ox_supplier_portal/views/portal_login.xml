<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="web.login" name="Login">
        <t t-call="web.login_layout">




            <div class="mb-3">
                <img t-if="img_login" t-attf-src="data:image/jpg;base64,{{img_login}}" style="width:600px;position:absolute;margin-right:150px" />
            </div>
            <form class="oe_login_form" role="form" t-attf-action="/web/login" method="post" onsubmit="this.action = '/web/login' + location.hash">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                <div class="mb-3" t-if="databases and len(databases) &gt; 1">
                    <label for="db" class="col-form-label">
						Database
                    </label>
                    <div t-attf-class="input-group {{'input-group-sm' if form_small else ''}}">
                        <input type="text" name="db" t-att-value="request.db" id="db" t-attf-class="form-control #{'form-control-sm' if form_small else ''}" required="required" readonly="readonly" />
                        <a role="button" href="/web/database/selector" class="btn btn-secondary">
							Select
                            <i class="fa fa-database" role="img" aria-label="Database" title="Database">
                            </i>
                        </a>
                    </div>
                </div>
                <div class="mb-3 field-login">
                    <label for="login" class="form-label">
						Usuario
                    </label>
                    <input type="text" placeholder="Usuario" name="login" t-att-value="login" id="login" t-attf-class="form-control #{'form-control-sm' if form_small else ''}" required="required" autocomplete="username" autofocus="autofocus" autocapitalize="off" />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">
						Password
                    </label>
                    <input type="password" placeholder="Password" name="password" id="password" t-attf-class="form-control #{'form-control-sm' if form_small else ''}" required="required" autocomplete="current-password" t-att-autofocus="'autofocus' if login else None" maxlength="4096" />
                </div>
                <p class="alert alert-danger" t-if="error" role="alert">
                    <t t-esc="error" />
                </p>
                <p class="alert alert-success" t-if="message" role="status">
                    <t t-esc="message" />
                </p>
                <div t-attf-class="clearfix oe_login_buttons text-center gap-1 d-grid mb-1 {{'pt-2' if form_small else 'pt-3'}}">
                    <button type="submit" class="btn btn-primary">
						Log in
                    </button>
                    <t t-if="debug">
                        <button type="submit" name="redirect" value="/web/become" class="btn btn-link btn-sm">
							Log in as superuser
                        </button>
                    </t>
                    <div class="o_login_auth" />
                </div>
                <input type="hidden" name="redirect" t-att-value="redirect" />
                <hr />
                <p>
                    <strong>
					¿Necesitas soporte de esta aplicación?
                    </strong>
                    <br />
                    <span>
					Línea de contacto servicios TI
                    </span>
                    <br />
                    <span>
					+57 3136617843
                    </span>
                    <br />
                    <span>
					Correo electrónico
                    </span>
                    <br />
                    <span>
					ingeniero.soporte@lorem ipsum.edu.co
                    </span>
                </p>

            </form>
        </t>
    </template>
</odoo>
