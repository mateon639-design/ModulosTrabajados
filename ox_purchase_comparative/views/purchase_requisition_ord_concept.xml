<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- purchase.requisition.order.concept action window -->
        <record id="purchase_requisition_order_concept_action" model="ir.actions.act_window">
            <field name="name">Conceptos de aprobación</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">purchase.requisition.order.concept</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Crear Nuevo Concepto!
                </p>
                <p>
                    No se han creado conceptos de aprobación!
                </p>
            </field>
        </record>

        <!-- purchase.requisition.order.concept tree view -->
        <record id="purchase_requisition_order_concept_view_tree" model="ir.ui.view">
            <field name="name">purchase.requisition.order.concept.view.tree</field>
            <field name="model">purchase.requisition.order.concept</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>
    </data>
</odoo>