<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- purchase.requisition.order.log action window -->
        <record id="purchase_requisition_order_log_action" model="ir.actions.act_window">
            <field name="name">Evento Requisicion</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">purchase.requisition.order.log</field>
            <field name="view_mode">list</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Evento Requisicion
                </p><p>No hay registros para visualizar!
                </p>
            </field>
        </record>

        <!-- purchase.requisition.order.log tree view -->
        <record id="purchase_requisition_order_log_view_tree" model="ir.ui.view">
            <field name="name">purchase.requisition.order.log.view.tree</field>
            <field name="model">purchase.requisition.order.log</field>
            <field name="arch" type="xml">
                <list create="false" edit="false" delete="false" default_order="create_date desc">
                    <field name="create_date" readonly="1" string="Fecha registro"/>
                    <field name="create_uid" readonly="1" string="Usuario"/>
                    <field name="name" readonly="1"/>
                    <field name="note" readonly="1"/>
                </list>
            </field>
        </record>

    </data>
</odoo>